# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://dashboard:password@localhost:5432/dashboard
DATABASE_SYNC_URL=postgresql://dashboard:password@localhost:5432/dashboard

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Meta Ads ──────────────────────────────────────────────────────────────────
# TODO: Obtenha em https://developers.facebook.com/apps/
META_APP_ID=TODO_your_meta_app_id
META_APP_SECRET=TODO_your_meta_app_secret
# Long-lived user or system user token com permissão ads_read
META_ACCESS_TOKEN=TODO_your_long_lived_access_token
# Separados por vírgula: act_XXXXXXX,act_YYYYYYY
META_AD_ACCOUNT_IDS=act_TODO_account_id
META_API_VERSION=v19.0

# ── Rezdy ─────────────────────────────────────────────────────────────────────
# TODO: Obtenha em https://app.rezdy.com/user/settings/apikey
REZDY_API_KEY=TODO_your_rezdy_api_key
REZDY_BASE_URL=https://api.rezdy.com/v1
# Secret configurado ao registrar o webhook na Rezdy (pode ser vazio se não usado)
REZDY_WEBHOOK_SECRET=TODO_generate_random_secret

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_ENV=development
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=TODO_generate_with_secrets_token_hex_32
# Header X-Sync-Secret usado pelo GitHub Actions para acionar syncs
SYNC_TRIGGER_SECRET=TODO_generate_with_secrets_token_hex_32
ALLOWED_ORIGINS=http://localhost:3000

# ── Workers ───────────────────────────────────────────────────────────────────
META_ADS_SYNC_INTERVAL_MINUTES=30
META_ADS_LOOKBACK_DAYS=3
META_ADS_FULL_LOOKBACK_DAYS=30
REZDY_RECONCILIATION_LOOKBACK_DAYS=7
WORKER_CONCURRENCY=4
